# SmartExn Production Environment Configuration Template
# Copy this file to .env or set these environment variables in your hosting provider settings (e.g. Google Cloud Run, Vercel, Docker).
# DO NOT commit production secrets (.env) to GitHub or public version control.

# ==============================================================================
# Client-Side Application Settings (Vite prefix required for browser visibility)
# ==============================================================================
VITE_APP_NAME="SmartExn - Global Micro Task Network"
VITE_SITE_URL="https://smartexn.com"
VITE_API_URL="/api"

# Google Analytics 4 Measurement ID (Inject real ID e.g. G-XXXXXXXXXX post-launch)
# Leave empty or unset in development/preview environments
VITE_GA4_MEASUREMENT_ID=""

# ==============================================================================
# Backend / Server-Side Environment Variables (Private & Secure)
# ==============================================================================
PORT=3000
NODE_ENV=production

# Server-Side Provider Integration Credentials (Awaiting Official Partner Contracts)
# TimeWall Publisher ID & Secret Key (Configure when official contract is finalized)
TIMEWALL_PUBLISHER_ID=""
TIMEWALL_SECRET_KEY=""

# CPX Research App ID & Secure Postback Hash (Configure when official contract is finalized)
CPX_RESEARCH_APP_ID=""
CPX_RESEARCH_SECURE_HASH=""

# Lootably Partner Credentials (Roadmap Integration)
LOOTABLY_API_KEY=""
LOOTABLY_SECRET_KEY=""

# BitLabs Survey Router Credentials (Roadmap Integration)
BITLABS_API_KEY=""
BITLABS_SECRET_KEY=""
